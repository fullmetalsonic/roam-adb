<Window x:Class="RoamADB.Gateway.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RoamADB Gateway" Width="1160" Height="800"
        Icon="roamadb-icon.ico"
        MinWidth="920" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#EEF1F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17233B" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RoamADB Gateway" Foreground="White" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="집 PC와 휴대폰 사이의 인증된 원격 ADB 중계" Foreground="#C9D4EA" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="HeaderStatusBorder" Background="#3F4C63" CornerRadius="18" Padding="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Text="● 꺼짐" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20" Background="White" Padding="4">
            <TabItem Header="연결 및 휴대폰 등록">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <GroupBox Header="1. PC Gateway">
                                <StackPanel>
                                    <TextBlock Text="Tailscale이 이미 연결된 상태에서 Gateway를 켜세요. 공유기 포트포워딩은 필요하지 않습니다."
                                               TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,14" />
                                    <WrapPanel>
                                        <Button x:Name="StartGatewayButton" Content="Gateway 켜기" Background="#2457D6" Foreground="White" Click="StartGateway_Click" />
                                        <Button x:Name="StopGatewayButton" Content="Gateway 끄기" IsEnabled="False" Click="StopGateway_Click" />
                                        <Button Content="다시 진단" Click="RunDiagnostics_Click" />
                                    </WrapPanel>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="PC 이름" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PcNameText" />
                                        <TextBlock Grid.Row="1" Text="Gateway 주소" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GatewayAddressText" Text="Gateway를 먼저 켜세요" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Text="최근 중계 상태" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RelayStatusText" Text="휴대폰 연결 대기" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2. 휴대폰 등록">
                                <StackPanel>
                                    <TextBlock Text="Gateway가 켜진 뒤 2분 동안만 유효한 등록 정보를 만듭니다. QR 스캔이 안 되면 아래 값을 수동 입력할 수 있습니다."
                                               TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,14" />
                                    <Button x:Name="IssueRegistrationButton" Content="새 등록 코드와 QR 만들기" IsEnabled="False"
                                            HorizontalAlignment="Left" Background="#2457D6" Foreground="White" Click="IssueRegistration_Click" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="6자리 등록 코드" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RegistrationCodeText" Text="------" FontFamily="Consolas" FontSize="32" FontWeight="Bold" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="코드 복사" Click="CopyCode_Click" />
                                        <TextBlock Grid.Row="1" Text="남은 시간" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RegistrationExpiryText" Text="등록 정보를 만들지 않음" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Text="PC 주소" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegistrationAddressText" Text="-" Margin="0,8,0,0" />
                                        <Button Grid.Row="2" Grid.Column="2" Content="주소 복사" Margin="0,5,0,0" Click="CopyAddress_Click" />
                                        <TextBlock Grid.Row="3" Text="인증서 지문" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FingerprintText" Text="-" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,8,0" />
                                        <Button Grid.Row="3" Grid.Column="2" Content="지문 복사" Margin="0,5,0,0" Click="CopyFingerprint_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <GroupBox Header="휴대폰에서 스캔">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="320" Height="320" Background="White" BorderBrush="#C8D0DD" BorderThickness="1" Padding="12">
                                        <Grid>
                                            <Image x:Name="RegistrationQrImage" Stretch="Uniform" />
                                            <TextBlock x:Name="QrPlaceholderText" Text="Gateway를 켠 다음&#x0a;등록 QR을 만드세요"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                       Foreground="#667085" FontSize="17" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="RoamADB 앱 → 집 PC 등록 → QR 스캔" FontWeight="SemiBold" Margin="0,14,0,0" />
                                    <TextBlock Text="QR에는 주소·일회용 코드·공개 인증서 지문만 포함되며 비밀키와 Tailscale 토큰은 들어가지 않습니다."
                                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#4A5568" Margin="0,8,0,0" MaxWidth="330" />
                                </StackPanel>
                            </GroupBox>

                            <Border Background="#FFF7E6" BorderBrush="#E9B949" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="보안 안내" FontWeight="Bold" Foreground="#7A4B00" />
                                    <TextBlock Text="모르는 휴대폰을 등록하지 마세요. Windows 방화벽·공유기 설정은 이 프로그램이 자동 변경하지 않습니다."
                                               TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#5E4600" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ADB 작업">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <GroupBox Header="최초 1회 무선 ADB 페어링">
                            <StackPanel>
                                <TextBlock Text="휴대폰에서 개발자 옵션 → 무선 디버깅 → 페어링 코드로 기기 페어링을 열고, RoamADB 앱에서 페어링 포트를 중계한 뒤 아래에 6자리 코드를 입력하세요."
                                           TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <TextBox x:Name="PairingCodeInput" Width="180" MaxLength="6" PreviewTextInput="DigitsOnly_PreviewTextInput" />
                                    <Button Content="ADB 페어링" Background="#2457D6" Foreground="White" Margin="10,0,0,0" Click="PairAdb_Click" />
                                </WrapPanel>
                                <TextBlock Text="페어링 코드는 명령 기록에 남기지 않습니다. 페어링 중계 포트는 PC의 127.0.0.1:47158입니다."
                                           Foreground="#667085" Margin="0,10,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="평상시 연결">
                            <StackPanel>
                                <TextBlock Text="휴대폰 앱에서 원격 디버깅을 켜고 ‘PC 연결 대기’ 상태가 된 뒤 실행하세요. 연결 중계 포트는 PC의 127.0.0.1:47157입니다."
                                           TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Content="ADB 연결" Background="#2457D6" Foreground="White" Click="ConnectAdb_Click" />
                                    <Button Content="ADB 연결 해제" Click="DisconnectAdb_Click" />
                                    <Button Content="기기 목록 새로고침" Click="ListAdbDevices_Click" />
                                    <Button Content="scrcpy 열기" Click="LaunchScrcpy_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="명령 결과">
                            <TextBox x:Name="AdbOutputText" Height="250" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" Text="아직 실행한 ADB 명령이 없습니다." />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="등록된 휴대폰">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Gateway에 등록된 휴대폰 공개키입니다. 모르는 기기나 더 이상 쓰지 않는 기기는 등록 해제하세요."
                               TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,12" />
                    <DataGrid Grid.Row="1" x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="휴대폰 이름" Binding="{Binding DeviceName}" Width="2*" />
                            <DataGridTextColumn Header="기기 ID" Binding="{Binding DeviceId}" Width="2*" />
                            <DataGridTextColumn Header="등록 시각 (한국)" Binding="{Binding RegisteredAtKst}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="목록 새로고침" Click="RefreshDevices_Click" />
                        <Button Content="선택한 휴대폰 등록 해제" Background="#B42318" Foreground="White" Click="RemoveDevice_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="진단 및 기록">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="준비 상태" Grid.Column="0">
                        <ListBox x:Name="DiagnosticsList" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,7">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#4A5568" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                    <GroupBox Header="최근 기록" Grid.Column="2">
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" />
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9DFEA" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="준비 상태를 확인하는 중…" Foreground="#344054" />
                <TextBlock Text="v0.1.2-spike · 시작 프로그램 자동 등록 안 함" HorizontalAlignment="Right" Foreground="#667085" />
            </Grid>
        </Border>
    </Grid>
</Window>
